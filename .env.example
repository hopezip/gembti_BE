# ── 앱 기본 ──────────────────────────────────────────────
APP_NAME=GEMBTI API
APP_ENV=development
DEBUG=False

# ── 데이터베이스 ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/your_db
DATABASE_SYNC_URL=postgresql+psycopg2://your_user:your_password@localhost:5432/your_db

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT / 인증 ────────────────────────────────────────────
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","https://gembti.cloud","https://www.gembti.cloud"]
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
TRUSTED_HOSTS=["localhost","127.0.0.1","gembti.cloud","www.gembti.cloud"]

# ── Rate Limit ────────────────────────────────────────────
RATE_LIMIT=200/minute

# ── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ── AWS S3 ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_PRESIGNED_URL_EXPIRE=3600

# ── Steam Web API ─────────────────────────────────────────
STEAM_API_KEY=your-steam-api-key
# Steam OpenID가 인증 후 돌아올 백엔드 주소입니다.
# 배포 환경에서는 실제 백엔드 도메인으로 설정하세요. 예: https://gembti.cloud
BACKEND_BASE_URL=http://localhost:8000
# Steam 로그인 완료 후 백엔드가 redirect할 프론트 주소입니다.
# 배포 환경에서는 실제 프론트 도메인으로 설정하세요. 예: https://gembti.cloud
FRONTEND_BASE_URL=http://localhost:3000
# FRONTEND_BASE_URL 뒤에 붙는 프론트 Steam 콜백 경로입니다.
STEAM_CALLBACK_PATH=/steam/callback

# ── 이메일 (fastapi-mail) ─────────────────────────────────
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-mail-password
MAIL_FROM=your@email.com
MAIL_PORT=587
MAIL_SERVER=smtp.your-mail-server.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ── Celery ───────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
