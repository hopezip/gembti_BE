# ── 앱 기본 ──────────────────────────────────────────────
APP_NAME=GEMBTI API
APP_ENV=development
DEBUG=True

# ── 데이터베이스 ──────────────────────────────────────────
# FastAPI (async): asyncpg 드라이버
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gembti
# Celery / Alembic (sync): psycopg2 드라이버
DATABASE_SYNC_URL=postgresql+psycopg2://user:password@localhost:5432/gembti

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT / 인증 ────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Steam Web API ─────────────────────────────────────────
STEAM_API_KEY=

# ── 이메일 (fastapi-mail / Gmail SMTP) ───────────────────
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=app-password
MAIL_FROM=your@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ── Celery ───────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
